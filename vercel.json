{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "includeFiles": "app.py"
    }
  },
  "rewrites": [
    {
      "source": "/submit/:path*",
      "destination": "/api"
    },
    {
      "source": "/submit",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}
